# Copia este archivo como .env y ajusta los valores.

# Contraseña para entrar a la web. Vacía = sin contraseña (solo para uso local).
APP_PASSWORD=
# Clave para firmar la sesión; si se deja vacía, las sesiones caducan al reiniciar.
SESSION_SECRET=

# Modelo por defecto: tiny, base, small, medium, large-v3-turbo, large-v3
WHISPER_MODEL=small
# Modelos que se ofrecen en la interfaz
ALLOWED_MODELS=tiny,base,small,medium,large-v3-turbo,large-v3
# Hilos de CPU (por defecto, todos los núcleos)
# CPU_THREADS=8

# Dónde se guardan subidas, trabajos y modelos (en Railway: el volumen, /data)
# DATA_DIR=./data

# Tamaño de cada trozo de subida en MB (con Cloudflare debe ser menor que 100)
CHUNK_SIZE_MB=32
# Tamaño máximo por archivo en GB (0 = sin límite)
MAX_UPLOAD_GB=0
# Espacio libre en MB que se guarda para el audio extraído (~115 MB por hora)
DISK_RESERVE_MB=256
# Minutos sin avance tras los que una subida cortada se borra si falta espacio
UPLOAD_STALL_MINUTES=30
# Horas que se conservan los trabajos terminados
RETENTION_HOURS=72
